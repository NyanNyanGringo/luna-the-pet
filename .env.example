# === Режим (dev = polling, prod = webhook) ===
APP_ENV=dev

# === Telegram ===
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# PROD пример:
# WEBHOOK_URL=https://luna.example.com/webhook
# WEBHOOK_SECRET=random-secret-string

# === OpenAI (API key = fallback, OAuth = primary) ===
OPENAI_API_KEY=sk-...
OPENAI_OAUTH_CLIENT_ID=
OAUTH_ENCRYPTION_KEY=  # Fernet: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# === База данных (dev-fallback: локальный PostgreSQL) ===
DATABASE_URL=postgresql+asyncpg://luna:password@localhost:5432/luna_dev_db
POSTGRES_PASSWORD=password

# === JWT ===
JWT_SECRET=random-jwt-secret

# === Приложение ===
DEBUG=true
MEDIA_DIR=./data/uploads
